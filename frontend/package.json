{
    "name": "tbsparcer",
    "version": "1.4.25",
    "description": "TBSparcer Desktop Application",
    "main": "electron/main.cjs",
    "author": "TBSparcer Team",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "electron:dev": "npm run build && electron .",
        "electron:build": "npm run build && electron-builder --config electron/release-config.cjs --win",
        "electron:build:portable": "npm run build && electron-builder --config electron/release-config.cjs --win portable",
        "electron:build:mac": "npm run build && electron-builder --mac",
        "electron:build:linux": "npm run build && electron-builder --linux",
        "electron:publish": "npm run build && electron-builder --config electron/release-config.cjs --win --publish always",
        "electron:publish:latest": "npm run electron:publish && node ./scripts/cleanup-github-releases.mjs",
        "test:electron-security": "node --test electron/tests/*.test.cjs"
    },
    "build": {
        "forceCodeSigning": false,
        "appId": "com.tbsparcer.app",
        "productName": "TBSparcer",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "electron/**/*"
        ],
        "extraResources": [
            {
                "from": "client-access.json",
                "to": "security/client-access.json"
            }
        ],
        "publish": [
            {
                "provider": "github",
                "owner": "asintiko",
                "repo": "parcer20-updates",
                "releaseType": "release"
            }
        ],
        "win": {
            "verifyUpdateCodeSignature": false,
            "requestedExecutionLevel": "requireAdministrator",
            "icon": "electron/assets/app.ico",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "portable",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "perMachine": true,
            "allowToChangeInstallationDirectory": true,
            "allowElevation": true,
            "installerIcon": "electron/assets/app.ico",
            "uninstallerIcon": "electron/assets/app.ico",
            "installerHeaderIcon": "electron/assets/app.ico",
            "artifactName": "${productName}-Setup-${version}.${ext}"
        },
        "portable": {
            "artifactName": "${productName}-Portable-${version}.${ext}"
        },
        "mac": {
            "target": "dmg"
        },
        "linux": {
            "target": "AppImage"
        }
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/material": "^7.3.7",
        "@mui/x-date-pickers": "^8.26.0",
        "@tanstack/query-sync-storage-persister": "^5.101.0",
        "@tanstack/react-query": "^5.17.19",
        "@tanstack/react-query-persist-client": "^5.101.0",
        "@tanstack/react-table": "^8.11.6",
        "@tanstack/react-virtual": "^3.13.18",
        "@types/react-window": "^1.8.8",
        "axios": "^1.18.1",
        "date-fns": "^3.1.0",
        "dayjs": "^1.11.19",
        "dexie": "^4.0.8",
        "electron-updater": "^6.1.8",
        "exceljs": "^4.4.0",
        "lucide-react": "^0.307.0",
        "motion": "^12.40.0",
        "qrcode.react": "^4.2.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-markdown": "^9.1.0",
        "react-router-dom": "^7.18.1",
        "react-window": "^2.2.5",
        "rehype-raw": "^7.0.0",
        "rehype-sanitize": "^6.0.0",
        "remark-gfm": "^4.0.1"
    },
    "devDependencies": {
        "@types/react": "^18.2.48",
        "@types/react-dom": "^18.2.18",
        "@typescript-eslint/eslint-plugin": "^6.18.1",
        "@typescript-eslint/parser": "^6.18.1",
        "@vitejs/plugin-react": "^4.2.1",
        "autoprefixer": "^10.4.16",
        "electron": "^40.0.0",
        "electron-builder": "^26.4.0",
        "eslint": "^8.56.0",
        "eslint-plugin-react-hooks": "^4.6.0",
        "eslint-plugin-react-refresh": "^0.4.5",
        "postcss": "^8.4.33",
        "tailwindcss": "^3.4.1",
        "typescript": "^5.3.3",
        "vite": "^5.0.11",
        "vite-plugin-static-copy": "^3.1.4"
    }
}
